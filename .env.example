# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-public-key..."
# Settings -> API -> service_role secret. SERVER ONLY. Never expose to the browser.
# Required for Stripe webhook / checkout verification to update `subscriptions`.
SUPABASE_SERVICE_ROLE_KEY="eyJ...your-service-role-key..."

# Direct Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL="postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres"

# --- Finnhub ---------------------------------------------------------------
# Free API key from https://finnhub.io/dashboard  (SERVER ONLY)
FINNHUB_API_KEY="your-finnhub-api-key"

# --- Stripe (TEST mode) --------------------------------------------------
# https://dashboard.stripe.com/test/apikeys -> Secret key
STRIPE_SECRET_KEY="sk_test_..."
# Created by `npm run stripe:setup`
STRIPE_PRICE_ID="price_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (optional)
STRIPE_WEBHOOK_SECRET="whsec_..."

# OPTIONAL. The app resolves its public origin from the incoming request, so this
# is only a fallback (e.g. for CLI/build contexts). Leave unset on Vercel.
# NEXT_PUBLIC_SITE_URL="https://your-canonical-domain.com"
